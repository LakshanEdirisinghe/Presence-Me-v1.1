<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:id="@+id/main"
    android:background="#F5F7FA"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Create New QR"
            android:textColor="#172B4D"
            android:textSize="25sp"
            android:textStyle="bold"
            android:layout_marginBottom="6dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Create a new attendance session"
            android:textColor="#6B7280"
            android:textSize="14sp"
            android:layout_marginBottom="24dp" />

        <!-- Student Batch -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Student Batch"
            android:textStyle="bold"
            android:textColor="#374151" />

        <Spinner
            android:id="@+id/spinnerBatch"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginBottom="16dp" />

        <!-- Academic Year -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Academic Year"
            android:textStyle="bold"
            android:textColor="#374151" />

        <Spinner
            android:id="@+id/spinnerAcademicYear"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginBottom="16dp" />

        <!-- Semester -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Semester"
            android:textStyle="bold"
            android:textColor="#374151" />

        <Spinner
            android:id="@+id/spinnerSemester"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginBottom="16dp" />

        <!-- Degree -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Degree Programme"
            android:textStyle="bold"
            android:textColor="#374151" />

        <Spinner
            android:id="@+id/spinnerDegree"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginBottom="16dp" />

        <!-- Subject -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Subject"
            android:textStyle="bold"
            android:textColor="#374151" />

        <Spinner
            android:id="@+id/spinnerSubject"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginBottom="24dp" />

        <!-- Lecture Start Time -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Lecture Start Time"
            android:textStyle="bold"
            android:textColor="#374151" />

        <Button
            android:id="@+id/btnStartTime"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Select Start Time"
            android:layout_marginBottom="16dp" />

        <!-- Lecture End Time -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Lecture End Time"
            android:textStyle="bold"
            android:textColor="#374151" />

        <Button
            android:id="@+id/btnEndTime"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Select End Time"
            android:layout_marginBottom="16dp" />

        <!-- QR Expiration -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="QR Expires At"
            android:textStyle="bold"
            android:textColor="#374151" />

        <Button
            android:id="@+id/btnQrExpiry"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Select Expiration Time"
            android:layout_marginBottom="28dp" />

        <!-- Generate QR -->
        <Button
            android:id="@+id/btnGenerateQR"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Generate QR"
            android:textAllCaps="false"
            android:textSize="16sp"
            android:textStyle="bold"
            android:backgroundTint="#2563EB"
            android:textColor="#FFFFFF" />

    </LinearLayout>

</ScrollView>